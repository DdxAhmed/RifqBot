{
  "name": "rifq-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic-first personal Telegram assistant",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:bot": "node src/app.js",
    "start:worker": "node src/scheduler/worker.js",
    "dev": "node --watch src/app.js",
    "worker:dev": "node --watch src/scheduler/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run prisma:generate && npm run lint && npm test"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.5.0",
    "luxon": "^3.6.1",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "prisma": "^6.7.0"
  }
}
